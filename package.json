{
  "name": "exersai",
  "version": "1.0.0",
  "description": "ExersAI monorepo React Native app + Node.js server",
  "private": true,
  "workspaces": [
    "apps/server",
    "apps/server_hono",
    "apps/exersai",
    "apps/admin-web",
    "apps/train-web",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server_hono",
    "dev:web": "npm run dev --workspace=admin-web",
    "dev:app": "npx react-native run-android --root apps/exersai",
    "db:generate": "npm run db:generate --workspace=admin-web",
    "db:migrate:local": "npm run db:migrate:local --workspace=admin-web",
    "db:migrate:remote": "npm run db:migrate:remote --workspace=admin-web",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.97.0",
    "openai": "^6.22.0"
  }
}
